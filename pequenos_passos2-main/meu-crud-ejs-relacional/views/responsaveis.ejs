<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Responsáveis - Pequenos Passos</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <header>
        <h1>Pequenos Passos</h1>
        <h2>Cadastro de Responsáveis</h2>
    </header>

    <main class="container">

        <form action="/responsaveis/cadastrar" method="POST">

            <label>Nome completo:</label>
            <input type="text" name="nome" required>

            <label>CPF:</label>
            <input type="text" name="cpf" required>

            <label>Telefone:</label>
            <input type="text" name="telefone" required>

            <label>E-mail:</label>
            <input type="email" name="email" required>

            <button type="submit">Cadastrar responsável</button>

        </form>

        <h2>Responsáveis cadastrados</h2>

        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>CPF</th>
                    <th>Telefone</th>
                    <th>E-mail</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                <% responsaveis.forEach(responsavel => { %>
                    <tr>
                        <td><%= responsavel.nome %></td>
                        <td>Protegido</td>
                        <td><%= responsavel.telefone %></td>
                        <td><%= responsavel.email %></td>

                        <td>
                            <a href="/responsaveis/editar/<%= responsavel.id_responsavel %>">
                                Editar
                            </a>

                            |

                            <a href="/responsaveis/excluir/<%= responsavel.id_responsavel %>"
                               onclick="return confirm('Deseja realmente excluir este responsável?')">
                                Excluir
                            </a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <a href="/dashboard">Voltar ao painel</a>

    </main>

</body>
</html>
