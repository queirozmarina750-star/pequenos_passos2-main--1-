
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Editar Criança - Pequenos Passos</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<header>
    <h1>Pequenos Passos</h1>
    <h2>Editar Criança</h2>
</header>

<main class="container">

    <form action="/criancas/editar/<%= crianca.id_crianca %>" method="POST">

        <label>Nome da criança:</label>
        <input type="text" name="nome"
            value="<%= crianca.nome %>" required>

        <label>Data de nascimento:</label>
        <input type="date" name="data_nascimento"
            value="<%= String(crianca.data_nascimento).slice(0, 10) %>" required>

        <label>Responsável:</label>
        <select name="responsavel_id" required>

            <% responsaveis.forEach(responsavel => { %>
                <option value="<%= responsavel.id_responsavel %>"
                    <%= responsavel.id_responsavel == crianca.responsavel_id ? 'selected' : '' %>>
                    <%= responsavel.nome %>
                </option>
            <% }) %>

        </select>

        <button type="submit">Salvar alterações</button>

        <a href="/criancas">Cancelar</a>

    </form>

</main>

</body>
</html>
